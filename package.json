{
  "name": "serverless-payment-webhooks",
  "version": "2.0.0",
  "description": "Payment webhooks on AWS that run exactly once: HMAC signature checks, an SQS buffer and DynamoDB idempotency. CDK, TypeScript.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest",
    "synth": "cdk synth --quiet",
    "check": "npm run build && npm test && npm run synth",
    "deploy": "cdk deploy",
    "destroy": "cdk destroy",
    "smoke": "ts-node scripts/smoke-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1151.0",
    "@aws-sdk/client-eventbridge": "^3.1151.0",
    "@aws-sdk/client-secrets-manager": "^3.1151.0",
    "@aws-sdk/client-sqs": "^3.1151.0",
    "@aws-sdk/lib-dynamodb": "^3.1151.0",
    "aws-cdk-lib": "^2.273.0",
    "cdk-nag": "^3.0.2",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.1152.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "aws-cdk": "^2.1145.0",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
